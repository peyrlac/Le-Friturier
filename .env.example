# ============================================================================
# MANDATORY
# ============================================================================

# Token du bot Discord.
DISCORD_TOKEN=

# URI de connexion MongoDB.
MONGO_TOKEN=

# Identifiant de l'application Discord.
DISCORD_ID=

# Channel de travail pour les uploads iCal et la feature spoiler.
UPLOAD_CHANNEL_ID=1225140754729402378

# ============================================================================
# OPTIONAL - DISCORD AND WEBHOOKS
# ============================================================================

# Identifiant du webhook Discord utilisé par le bot.
WEBHOOK_ID=

# Token du webhook Discord utilisé par le bot.
WEBHOOK_TOKEN=

# Statut personnalisé affiché par le bot.
DISCORD_STATUS=""

# Supprime les commandes de guilde lors du nettoyage de Discord.
DISCORD_CLEANUP_GUILD_COMMANDS=false

# ============================================================================
# OPTIONAL - DATABASE AND RUNTIME
# ============================================================================

# Serveurs DNS optionnels, séparés par des virgules, pour résoudre mongodb+srv.
MONGO_DNS_SERVERS=

# Environnement d'exécution.
NODE_ENV=production

# Identifiant Discord du propriétaire du bot.
BOT_OWNER_ID=

# ============================================================================
# OPTIONAL - STATISTICS AND EXTERNAL APIS
# ============================================================================

# URL de l'API de statistiques.
STATS_API_URL=

# Clé d'authentification de l'API de statistiques.
STATS_API_KEY=

# Token API Top.gg pour les statistiques de vote.
TOPGG_TOKEN=

# Clé API OpenAI.
OPENAI=

# ============================================================================
# OPTIONAL - MUSIC
# ============================================================================

# Station ou source radio utilisée par les fonctionnalités musicales.
RADIO=

# Identifiant client de l'application Spotify.
SPOTIFY_CLIENT_ID=

# Secret client de l'application Spotify.
SPOTIFY_CLIENT_SECRET=

# Adresse de l'instance Lavalink.
LAVALINK_HOST=

# Mot de passe de l'instance Lavalink.
LAVALINK_PASSWORD=

# Port de l'instance Lavalink.
LAVALINK_PORT=2333

# Indique si la connexion Lavalink doit utiliser TLS.
LAVALINK_SECURE=false

# Active ou désactive Lavalink.
LAVALINK_ENABLED=true
